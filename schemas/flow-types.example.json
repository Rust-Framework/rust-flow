{
  "version": "1.0",
  "types": {
    "common": {
      "label": "常用节点",
      "category": "common",
      "description": "通用处理节点",
      "default_data": { "expression": "" },
      "default_size": { "width": 200, "height": 41 },
      "ports": [
        { "id": "in", "label": "in", "direction": "Input", "side": "Left" },
        { "id": "out", "label": "out", "direction": "Output", "side": "Right" }
      ],
      "fields": [
        { "key": "label", "label": "标签", "type": "text" },
        { "key": "expression", "label": "表达式", "type": "expression", "placeholder": "e.g. process(input)" }
      ],
      "render": {
        "accent": "#8C8C8E",
        "title": "{{label}}"
      }
    },
    "branch": {
      "label": "条件分支",
      "category": "control",
      "description": "If / Else 条件分支",
      "default_data": { "condition": "" },
      "default_size": { "width": 180, "height": 72 },
      "ports": [
        { "id": "in", "direction": "Input", "side": "Left" },
        { "id": "true", "label": "true", "direction": "Output", "side": "Right" },
        { "id": "false", "label": "false", "direction": "Output", "side": "Right" }
      ],
      "fields": [
        { "key": "label", "label": "标签", "type": "text" },
        { "key": "condition", "label": "条件表达式", "type": "expression", "placeholder": "e.g. x > 0" }
      ],
      "render": {
        "accent": "#8B5AD8",
        "title": "If / Else",
        "subtitle": "if ({{data.condition}})",
        "footer": "true · false"
      }
    },
    "loop": {
      "label": "循环遍历",
      "category": "control",
      "description": "For-each 循环节点",
      "default_data": {
        "iterator": "item",
        "collection": "",
        "max_iterations": 1000
      },
      "default_size": { "width": 200, "height": 64 },
      "ports": [
        { "id": "in", "direction": "Input", "side": "Left" },
        { "id": "out", "label": "out", "direction": "Output", "side": "Right" },
        { "id": "body", "label": "body", "direction": "Output", "side": "Bottom" }
      ],
      "fields": [
        { "key": "label", "label": "标签", "type": "text" },
        { "key": "iterator", "label": "迭代变量", "type": "text", "default": "item" },
        { "key": "collection", "label": "集合", "type": "expression", "placeholder": "e.g. items" },
        { "key": "max_iterations", "label": "最大迭代次数", "type": "number", "default": 1000 }
      ],
      "render": {
        "accent": "#E68C33",
        "title": "{{label}}",
        "subtitle": "for {{data.iterator}} in {{data.collection}}",
        "body": ["body ↓"]
      }
    }
  }
}
