{
  "version": "1.0",
  "name": "订单履约流程",
  "nodes": [
    {
      "id": "trigger",
      "type": "trigger",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "订单创建事件",
        "event": "order.created"
      },
      "width": 220,
      "height": 44
    },
    {
      "id": "fetch_order",
      "type": "http",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "拉取订单",
        "method": "GET",
        "url": "/api/orders/{order_id}"
      },
      "width": 220,
      "height": 56
    },
    {
      "id": "check_stock",
      "type": "common",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "库存校验",
        "expression": "inventory.reserve(order.lines)"
      },
      "width": 220,
      "height": 52
    },
    {
      "id": "route_customer",
      "type": "branch",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "客户分级路由",
        "collapsed": false,
        "branches": [
          {
            "id": "vip",
            "label": "VIP 客户",
            "condition": "order.tier == 'vip'"
          },
          {
            "id": "standard",
            "label": "普通客户",
            "condition": "order.tier == 'standard'"
          },
          {
            "id": "reject",
            "label": "拒绝履约",
            "condition": "else"
          }
        ]
      },
      "width": 260,
      "height": 140
    },
    {
      "id": "vip_gift",
      "type": "common",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "VIP 礼遇",
        "expression": "apply_vip_benefits(order)"
      },
      "width": 220,
      "height": 52
    },
    {
      "id": "loop_lines",
      "type": "loop",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "遍历订单行",
        "iterator": "line",
        "collection": "order.lines",
        "max_iterations": 500
      },
      "width": 248,
      "height": 176
    },
    {
      "id": "deduct_stock",
      "type": "common",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "扣减库存",
        "expression": "inventory.deduct(line.sku, line.qty)"
      },
      "width": 220,
      "height": 52
    },
    {
      "id": "create_shipment",
      "type": "http",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "创建物流单",
        "method": "POST",
        "url": "/api/shipments"
      },
      "width": 220,
      "height": 56
    },
    {
      "id": "notify_user",
      "type": "common",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "通知用户",
        "expression": "notify.send(order.user_id, 'shipped')"
      },
      "width": 220,
      "height": 52
    },
    {
      "id": "reject_notify",
      "type": "common",
      "position": { "x": 0, "y": 0 },
      "data": {
        "label": "拒绝通知",
        "expression": "notify.send(order.user_id, 'rejected')"
      },
      "width": 220,
      "height": 52
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "trigger",
      "target": "fetch_order",
      "sourceHandle": "out",
      "targetHandle": "in"
    },
    {
      "id": "e2",
      "source": "fetch_order",
      "target": "check_stock",
      "sourceHandle": "out",
      "targetHandle": "in"
    },
    {
      "id": "e3",
      "source": "check_stock",
      "target": "route_customer",
      "sourceHandle": "out",
      "targetHandle": "in"
    },
    {
      "id": "e_vip",
      "source": "route_customer",
      "target": "vip_gift",
      "sourceHandle": "vip",
      "targetHandle": "in"
    },
    {
      "id": "e_std",
      "source": "route_customer",
      "target": "loop_lines",
      "sourceHandle": "standard",
      "targetHandle": "in"
    },
    {
      "id": "e_reject",
      "source": "route_customer",
      "target": "reject_notify",
      "sourceHandle": "reject",
      "targetHandle": "in"
    },
    {
      "id": "e_vip_loop",
      "source": "vip_gift",
      "target": "loop_lines",
      "sourceHandle": "out",
      "targetHandle": "in"
    },
    {
      "id": "e_loop_body",
      "source": "loop_lines",
      "target": "deduct_stock",
      "sourceHandle": "body",
      "targetHandle": "in"
    },
    {
      "id": "e_loop_back",
      "source": "deduct_stock",
      "target": "loop_lines",
      "sourceHandle": "out",
      "targetHandle": "continue"
    },
    {
      "id": "e_loop_out",
      "source": "loop_lines",
      "target": "create_shipment",
      "sourceHandle": "out",
      "targetHandle": "in"
    },
    {
      "id": "e_ship_notify",
      "source": "create_shipment",
      "target": "notify_user",
      "sourceHandle": "out",
      "targetHandle": "in"
    }
  ],
  "viewport": { "x": 0, "y": 0, "zoom": 1 }
}
